# Copy to .env and adjust. Never commit .env.
DOCFLOW_ENVIRONMENT=local
DOCFLOW_DATABASE_URL=postgresql+psycopg://docflow:docflow@localhost:5432/docflow

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCFLOW_JWT_SECRET=

# Only needed when running the API or worker outside Docker against the compose services.
# DOCFLOW_REDIS_URL=redis://localhost:6379/0
# DOCFLOW_S3_ENDPOINT_URL=http://localhost:8333
# AWS_ACCESS_KEY_ID=docflow-local
# AWS_SECRET_ACCESS_KEY=docflow-local-secret

# Used from M2b by the worker. Use a key from a dedicated project with a budget limit.
OPENAI_API_KEY=
